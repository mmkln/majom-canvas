# Client-side environment variables (Vite exposes VITE_* to browser code).
# Do not put secrets here.

# API endpoints
VITE_API_URL=https://mxll.pythonanywhere.com
# Browser-exposed chat key for local development only. Use a backend proxy in production.
VITE_GROK_API_KEY=

# Flags
VITE_CANVAS_PERF_LOG=false
# Dev-only flag. In DEV, Kanban is enabled by default unless this is "false".
VITE_ENABLE_KANBAN_DEV=true
# Routines visibility flag (enabled by default in all environments).
VITE_ENABLE_ROUTINES=true

# Build base path (used in vite.config.ts)
VITE_APP_BASE=./
