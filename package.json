{
  "name": "canvas-ts-project",
  "version": "0.2.0",
  "homepage": "https://mmkln.github.io/majom-canvas",
  "description": "Проект Canvas Task Manager на TypeScript",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:canvas-core": "vite build -c vite.canvas-core.config.ts && npm run build:canvas-core:types",
    "build:canvas-core:types": "tsc -p tsconfig.canvas-core.json",
    "pack:canvas-core": "npm run build:canvas-core && npm pack ./packages/canvas-core",
    "build:repo": "vite build --base=/majom-canvas/",
    "build:domain": "vite build --base=/",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "start": "npm run start:8080",
    "start:8080": "vite --port=8080",
    "start:4200": "vite --port=4200",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "deploy:build": "npm run build && npm run deploy",
    "deploy:repo": "npm run build:repo && npm run deploy",
    "deploy:domain": "npm run build:domain && npm run deploy",
    "go": "npm run deploy:domain",
    "test": "vitest run",
    "test:canvas-core": "vitest run src/canvas-core"
  },
  "keywords": [
    "canvas",
    "typescript",
    "drawing",
    "deletion"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^5.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "jwt-decode": "^4.0.0",
    "rxjs": "^7.8.2",
    "rxjs-http-client": "^8.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "uuid": "^11.1.0"
  }
}
